# .gitignore for .NET projects (Visual Studio / Rider / VS Code)

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Build folders
bin/
obj/
out/
publish/

# Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# Visual Studio cache/options
TestResults/

# NuGet
*.nupkg
.packages/
.nuget/packages/
.nuget/*

# dotnet local tools
.dotnet/tools/

# ASP.NET / Node
wwwroot/node_modules/
node_modules/
npm-debug.log*
yarn-error.log*

# Local app settings - do NOT commit secrets
#appsettings.Development.json
appsettings.Local.json
secrets.json
local.settings.json
.env
.env.*

# Entity Framework/DACPAC
*.mdf
*.ldf
*.bacpac

# User-specific files
*.rsuser
*.dbmdl
*.bak
*.Backup
*.log

# Rider/ReSharper
*_ReSharper.*
_ReSharper*/
*.DotSettings.user

# macOS
.DS_Store

# Windows
Thumbs.db

# Others
coverage/ 
coverage.*

# Generated by build
*/project.assets.json

# Lock files
project.lock.json

# Backup files
*_history/

# End of file
.claude/settings.local.json
tmpclaude-*-cwd
nul
