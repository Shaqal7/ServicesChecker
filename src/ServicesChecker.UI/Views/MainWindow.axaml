<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ServicesChecker.UI.ViewModels"
        xmlns:views="using:ServicesChecker.UI.Views"
        x:Class="ServicesChecker.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Services Checker"
        Width="800"
        Height="600"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <!-- Title Bar with Theme Toggle -->
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Padding="16,8">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6M12,8A4,4 0 0,0 8,12A4,4 0 0,0 12,16A4,4 0 0,0 16,12A4,4 0 0,0 12,8Z"
                           Width="24" Height="24"
                           Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Services Checker"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding ToggleThemeCommand}"
                        Background="Transparent"
                        Padding="8"
                        ToolTip.Tip="Toggle Theme">
                    <PathIcon Data="M12,18C11.11,18 10.26,17.8 9.5,17.45C11.56,16.5 13,14.42 13,12C13,9.58 11.56,7.5 9.5,6.55C10.26,6.2 11.11,6 12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18M20,8.69V4H15.31L12,0.69L8.69,4H4V8.69L0.69,12L4,15.31V20H8.69L12,23.31L15.31,20H20V15.31L23.31,12L20,8.69Z"
                              Width="20" Height="20"/>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Padding="16">
            <TabItem Header="Services">
                <views:ServicesTabView DataContext="{Binding ServicesTab}"/>
            </TabItem>
            <TabItem Header="Configuration">
                <views:ConfigurationTabView DataContext="{Binding ConfigurationTab}"/>
            </TabItem>
            <TabItem Header="Statistics">
                <views:StatisticsTabView DataContext="{Binding StatisticsTab}"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
